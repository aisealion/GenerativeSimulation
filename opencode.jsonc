{
  // 2026-09-21: migrated to opencode v2's config schema (see
  // https://opencode.ai/v2/docs/migrate-v1/) — provider -> providers,
  // npm -> package (aisdk: prefix), options -> settings, mcp -> mcp.servers.
  // NOTE: the published https://opencode.ai/config.json schema has NOT
  // caught up to v2 yet (confirmed independently: it still validates
  // against v1 field names like "provider"/"npm"/"options" and rejects
  // "disabled" on an MCP server, a known, currently-open discrepancy) —
  // editor validation against $schema may show false-positive squiggles
  // on these v2 field names. Don't "fix" this file to satisfy the stale
  // schema; the real opencode v2 binary parses this shape correctly per
  // its own docs.
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/Kimi-K2.5",
  "providers": {
    "litellm": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Otago LiteLLM",
      "settings": {
        "baseURL": "https://llm.uod.otago.ac.nz/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "gpt-5.4": {
          "name": "GPT-5.4",
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B"
        },
        "DeepSeek-V3.2": {
          "name": "DeepSeek V3.2"
        },
        "Kimi-K2.5": {
          "name": "Kimi K2.5"
        }
        // text-embedding-3-small omitted: embedding model, not usable for chat/agents
      }
    },
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "settings": {
        // Ollama's OpenAI-compatible endpoint doesn't check the key, but the
        // client library requires some non-empty string here.
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gpt-oss:120b": {
          "name": "GPT-OSS 120B (local Ollama)",
          "limit": { "context": 131072, "output": 131072 }
        },
        // norm-architect and norm-auditor both route to this by default
        // (NORM_ARCHITECT_MODEL / NORM_AUDITOR_MODEL, see engine/simulate.py)
        // — two separate opencode sessions against the same weights is
        // fine ("never let the model that wrote the code approve its own
        // work" is about session/context separation, not the model tag).
        // Exact tag is a placeholder — override via env var if your local
        // Ollama registry names it differently.
        //
        // deepseek-r1:70b is a Llama-3.3-70B distillation, NOT the same
        // architecture as gpt-oss:120b — don't copy that model's 131072
        // figure over blindly. It advertises a 128K ceiling (inherited
        // from its Llama-3.3 base), but real-world reports (Ollama's own
        // community guidance, multiple hosted-API providers) converge on
        // noticeably degraded quality well before that, and its own long
        // chain-of-thought reasoning eats into whatever context budget is
        // set aside for output. 65536 (64K) context / 32768 (32K) output
        // is a middle ground actually exercised elsewhere (Azure AI
        // Foundry, AWS Bedrock both cap DeepSeek-R1 output at 32768) —
        // override via OLLAMA_NUM_CTX_ARCHITECT if a real run shows this
        // is too tight or too generous.
        "deepseek-r1:70b": {
          "name": "DeepSeek-R1 70B (local Ollama, reasoning/audit)",
          "limit": { "context": 65536, "output": 32768 }
        },
        // norm-engineer routes to this by default (NORM_ENGINEER_MODEL).
        // Exact tag is a placeholder — override via env var if needed.
        //
        // qwen3-coder:30b (Qwen3-Coder-30B-A3B, a sparse MoE — 30B total,
        // ~3B active per token) natively supports 262144 (256K) context,
        // over 2x gpt-oss:120b's 131072 — kept at 131072 here anyway,
        // deliberately not raised to match its own native ceiling: this
        // repo's real observed need (an agentic session with 80+ tool
        // calls) was satisfied by 131072 for the analogous role
        // (gpt-oss:120b), and doubling context here would double this
        // model's own KV-cache VRAM cost for no demonstrated benefit,
        // compounding the already-unverified VRAM headroom for this new
        // model combination (see hpc_ollama_entrypoint.sh's own comment).
        // Output raised to 65536, the model's own documented "recommended
        // max" (vs. 32768 "standard") — code-generation turns can produce
        // large multi-file diffs in one response.
        "qwen3-coder:30b": {
          "name": "Qwen3-Coder-Next (local Ollama, engineering)",
          "limit": { "context": 131072, "output": 65536 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        // v1 used "enabled": true here — v2's docs explicitly show this
        // field inverted to "disabled" (see the migration-guide comment
        // at the top of this file for why $schema validation may still
        // flag this as wrong; trust the docs, not the stale schema).
        "disabled": false
      }
    }
  }
}
