{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/Kimi-K2.5",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Otago LiteLLM",
      "options": {
        "baseURL": "https://llm.uod.otago.ac.nz/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "gpt-5.4": {
          "name": "GPT-5.4",
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B"
        },
        "DeepSeek-V3.2": {
          "name": "DeepSeek V3.2"
        },
        "Kimi-K2.5": {
          "name": "Kimi K2.5"
        }
        // text-embedding-3-small omitted: embedding model, not usable for chat/agents
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        // Ollama's OpenAI-compatible endpoint doesn't check the key, but the
        // client library requires some non-empty string here.
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gpt-oss:120b": {
          "name": "GPT-OSS 120B (local Ollama)"
        }
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
